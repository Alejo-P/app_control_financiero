{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mi-presupuesto-reportes",
  "main": "src/index.js",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "REPORT_TO": "pinzonmarcelo759@gmail.com",
    "REPORT_FROM": "Mi Presupuesto <onboarding@resend.dev>"
  },
  "ratelimits": [
    { "name": "IP_LIMITER", "namespace_id": "95720301", "simple": { "limit": 3, "period": 60 } },
    { "name": "SERVICE_LIMITER", "namespace_id": "95720302", "simple": { "limit": 10, "period": 60 } }
  ],
  "observability": { "enabled": false }
}
